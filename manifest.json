{
  "manifest_version": 2,
  "name": "Ключи и подписки",
  "version": "1.0",
  "description": "КЛЮЧИ И ПОДПИСКИ после каждого слова ключи в тексте",
  "author": "Teemley",
  
  "icons": {
    "128": "icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch?v=*"],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    "keys.mp3"
  ],

  "permissions": [
    "https://www.youtube.com/*"
  ]
}