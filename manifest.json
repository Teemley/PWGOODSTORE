{
  "manifest_version": 3,
  "name": "Ключи и Подписки",
  "version": "1.0",
  "description": "КЛЮЧИ И ПОДПИСКИ после каждого слова ключи в тексте",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["keys.mp3"],
    "matches": ["https://*.youtube.com/*"]
  }]
}